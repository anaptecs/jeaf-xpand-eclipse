<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="JEAF Xpand Eclipse">
	<locations>
		<!-- Eclipse 2024-09 is the last release running on Java 17. Newer Eclipse releases can use the plug-ins as well. -->
		<location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="planner" includeSource="true" type="InstallableUnit">
			<repository location="https://download.eclipse.org/releases/2024-09/"/>
			<!-- Unchanged runtime of Eclipse Xpand 2.2.0, part of our own update site (version folder for reproducible builds) -->
			<repository location="https://www.jeaf-generator.io/distribution/xpand/2.3.0/"/>
			<unit id="org.eclipse.platform.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.jdt.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.emf.sdk.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.uml2.sdk.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.emf.mwe.sdk.feature.group" version="0.0.0"/>
			<!-- Runtime of Xpand 2.2.0 (unchanged). Features of Xpand 2.2.0 can't be used as they contain the UI plug-ins 2.2.0. -->
			<unit id="org.eclipse.xtend" version="2.2.0.v201605260315"/>
			<unit id="org.eclipse.xpand" version="2.2.0.v201605260315"/>
			<unit id="org.eclipse.xtend.profiler" version="2.2.0.v201605260315"/>
			<unit id="org.eclipse.xtend.util.stdlib" version="2.2.0.v201605260315"/>
			<unit id="org.eclipse.xtend.typesystem.emf" version="2.2.0.v201605260315"/>
			<unit id="org.eclipse.xtend.typesystem.uml2" version="2.2.0.v201605260315"/>
			<unit id="org.antlr.runtime" version="[3.2.0,3.2.1)"/>
		</location>
	</locations>
</target>
