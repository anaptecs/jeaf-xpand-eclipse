<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>
   <!--<extension
         point="org.eclipse.ui.startup">
      <startup
            class="org.eclipse.xtend.typesystem.emf.ui.internal.EarlyStarter"></startup>
   </extension>-->

   <extension
         point="org.eclipse.xtend.shared.ui.metamodelContributor">
      <metamodelContributor
            class="org.eclipse.xtend.typesystem.emf.ui.EmfMetamodelContributor"
            name="EMF Metamodels"/>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            id="org.eclipse.xtend.typesystem.emf.ui.addOperationDelegation"
            name="%action.add.EOperation..delegation.label">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="org.eclipse.xtend.typesystem.emf.ui.actions.AddAnnotationsHandler"
            commandId="org.eclipse.xtend.typesystem.emf.ui.addOperationDelegation">
         <!-- Only for one Ecore model at a time -->
         <enabledWhen>
            <with
                  variable="selection">
               <count
                     value="1">
               </count>
            </with>
         </enabledWhen>
      </handler>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <!-- Context menu of Ecore models -->
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="org.eclipse.xtend.ui.menu"
               label="%menu.label">
            <command
                  commandId="org.eclipse.xtend.typesystem.emf.ui.addOperationDelegation"
                  label="%action.add.EOperation..delegation.label"
                  style="push">
            </command>
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <adapt
                           type="org.eclipse.core.resources.IFile">
                        <test
                              property="org.eclipse.core.resources.extension"
                              value="ecore">
                        </test>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </menu>
      </menuContribution>
   </extension>

</plugin>
